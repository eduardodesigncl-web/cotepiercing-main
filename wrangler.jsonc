{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cotepiercing-main",
  "compatibility_date": "2026-05-14",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./src/server.ts",
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "run_worker_first": true
  }
}