{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cotepiercing-main",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/server.ts",
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },
  "version_metadata": {
    "binding": "CF_VERSION_METADATA",
  },
  "assets": {
    "directory": "./dist/client",
  },
}
